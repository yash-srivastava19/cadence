# Copy to .env and adjust. docker compose reads this file automatically.
POSTGRES_PASSWORD=cadence
POSTGRES_PORT=5433

# The database you develop against. Nothing automated should touch it.
DATABASE_URL=postgresql://cadence:cadence@localhost:5433/cadence
DATABASE_APP_URL=postgresql://cadence_app:cadence_app@localhost:5433/cadence

# The database the suite creates and drops tables in. Same container, own data.
TEST_DATABASE_URL=postgresql://cadence:cadence@localhost:5433/cadence_test
TEST_DATABASE_APP_URL=postgresql://cadence_app:cadence_app@localhost:5433/cadence_test
