# Copy to .env and adjust. docker compose reads this file automatically.
POSTGRES_PASSWORD=cadence
POSTGRES_PORT=5433

# Owns the schema: migrations run as this role.
DATABASE_URL=postgresql://cadence:cadence@localhost:5433/cadence

# What the application connects as. Cannot UPDATE or DELETE an audit table.
DATABASE_APP_URL=postgresql://cadence_app:cadence_app@localhost:5433/cadence
